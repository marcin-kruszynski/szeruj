# Public address used in generated links and social metadata.
# .local is a friendly LAN default; point it at your DNS name in production.
SZERUJ_PUBLIC_URL=http://szeruj.local:8369

# Docker/Compose settings.
SZERUJ_BIND_ADDRESS=0.0.0.0
SZERUJ_PORT=8369
SZERUJ_DATA_PATH=./data
SZERUJ_MEMORY_LIMIT=2g
SZERUJ_UID=1000
SZERUJ_GID=1000
SZERUJ_IMAGE=szeruj:local
SZERUJ_CONTAINER_NAME=szeruj

# Admin and agent API credentials. Keep these empty until you generate them
# with `npm run setup` or replace them with long, unique random values.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
API_TOKEN=
