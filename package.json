{
  "name": "szeruj",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "dev": "SZERUJ_STORAGE_DRIVER=node vinext dev --hostname 0.0.0.0",
    "dev:cloudflare": "SZERUJ_STORAGE_DRIVER=cloudflare WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --hostname 0.0.0.0",
    "build": "SZERUJ_STORAGE_DRIVER=node vinext build",
    "build:cloudflare": "SZERUJ_STORAGE_DRIVER=cloudflare WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "SZERUJ_STORAGE_DRIVER=node node --no-warnings dist/standalone/server.js",
    "test": "npm run build && node --import tsx --test tests/*.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "data:migrate": "node --no-warnings scripts/migrate-miniflare-data.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@cloudflare/workers-types": "^5.20260814.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vinext": "0.0.45",
    "vite": "8.2.1",
    "wrangler": "^4.123.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "type": "module"
}
